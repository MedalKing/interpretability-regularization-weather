{
  "feature_cols": [
    "tmin",
    "tavg",
    "tmax",
    "prcp",
    "dayofyear_sin",
    "dayofyear_cos",
    "rand_noise"
  ],
  "candidate_features": [
    "tmin",
    "tavg",
    "tmax",
    "prcp"
  ],
  "pair_settings": [
